    {
      "id": "golden_011",
      "question": "论文在实验中是如何调整参数或设计提示词的，从而使得思维链（Chain-of-Thought）等语言推理技术大幅提升了模型在“房间大小（Room Size）”估计任务上的准确率？",
      "answerable": true,
      "expectation": "corrective_answer",
      "status": "ok",
      "error": null,
      "retrieval_state": "hit",
      "answer_state": "pass",
      "retrieved_chunk_ids": [
        "ab7afc504277060318fc71f2",

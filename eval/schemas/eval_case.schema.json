{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paper-rag.local/schemas/eval_case.schema.json",
  "title": "Paper RAG Eval Case",
  "description": "用于本地 PDF RAG 确定性评测的一条 JSONL eval case。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "question",
    "answerable",
    "evidence",
    "answer_terms",
    "notes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "description": "单个数据集内稳定唯一的 case ID。"
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "description": "提交给 RAG 系统的自然语言问题。"
    },
    "answerable": {
      "type": "boolean",
      "description": "兼容字段，表示该样本是否要求生成带 citation 的答案；必须与 expectation 保持一致。"
    },
    "expectation": {
      "type": "string",
      "enum": [
        "direct_answer",
        "corrective_answer",
        "insufficient_detail",
        "out_of_scope_refusal"
      ],
      "description": "评测期望类型；缺失时由 parser 根据 answerable 兼容推导。"
    },
    "evidence": {
      "type": "array",
      "description": "检索和 citation 应命中的多论文证据组；语料外拒答题可以为空。",
      "items": {
        "$ref": "#/$defs/evidenceGroup"
      }
    },
    "answer_terms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "description": "期望出现在最终答案或拒答文本中的关键词或短语。"
    },
    "reference_answer": {
      "type": "string",
      "description": "可选的人工参考答案，供后续 answer quality 评测或人工复核使用。"
    },
    "notes": {
      "type": "string",
      "description": "人工审核备注、假设或注意事项。"
    },
    "evaluation_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "可选的语义评估要求，用于 LLM judge 判断答案是否满足预期回答点。"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "answerable": {
            "const": true
          }
        },
        "required": [
          "answerable"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "expectation": {
            "enum": [
              "direct_answer",
              "corrective_answer",
              "insufficient_detail"
            ]
          }
        },
        "required": [
          "expectation"
        ]
      },
      "then": {
        "properties": {
          "answerable": {
            "const": true
          },
          "evidence": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "expectation": {
            "const": "out_of_scope_refusal"
          }
        },
        "required": [
          "expectation"
        ]
      },
      "then": {
        "properties": {
          "answerable": {
            "const": false
          }
        }
      }
    }
  ],
  "$defs": {
    "evidenceGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doc_key",
        "page_start",
        "page_end",
        "terms"
      ],
      "properties": {
        "doc_key": {
          "type": "string",
          "minLength": 1,
          "description": "评测集文档短键，对应 golden.documents.json 中的 key。"
        },
        "page_start": {
          "type": "integer",
          "minimum": 1,
          "description": "该证据组的起始页，闭区间。"
        },
        "page_end": {
          "type": "integer",
          "minimum": 1,
          "description": "该证据组的结束页，闭区间。"
        },
        "terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "description": "该证据组中期望出现在检索文本里的关键词或短语。"
        }
      }
    }
  }
}

